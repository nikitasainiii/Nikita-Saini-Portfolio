{
  "version": 2,
  "functions": {
    "dist/server/server.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/dist/client/assets/$1" },
    { "source": "/ResumeNikita.pdf", "destination": "/dist/client/ResumeNikita.pdf" },
    { "source": "/(.*)", "destination": "/dist/server/server.js" }
  ]
}
